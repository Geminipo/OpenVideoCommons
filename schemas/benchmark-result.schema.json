{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvideocommons.org/schemas/benchmark-result.schema.json",
  "title": "OpenVideoCommons Benchmark Result",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "contributor",
    "model",
    "prompt_set",
    "hardware",
    "software",
    "run",
    "artifacts",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "contributor": {
      "type": "object",
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "prompt_set": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "hardware": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string"
        },
        "gpu": {
          "type": "string"
        },
        "vram_gb": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "ram_gb": {
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "software": {
      "type": "object",
      "required": ["python"],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string"
        },
        "cuda": {
          "type": ["string", "null"]
        },
        "torch": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["status", "generation_time_sec", "command"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failed", "partial"]
        },
        "generation_time_sec": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "command": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "output_hash": {
          "type": ["string", "null"]
        },
        "log_hash": {
          "type": ["string", "null"]
        },
        "output_uri": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["self_reported", "reviewed", "accepted", "rejected"]
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
